---
import "@fontsource-variable/inter";
import "@fontsource-variable/source-serif-4";
import "../styles/global.css";

const { title } = Astro.props;
const siteTitle = "Michele Tadiello | Healthcare AI and Informatics";
const pageTitle = title ? `${title} | Michele Tadiello` : siteTitle;
const description =
  "Michele Tadiello gets clinical data flowing and AI working where care happens, through clinical informatics, healthcare AI, and strategy & advisory.";
// Link-preview card (public/og.png): name and title over the home page's data lanes
const ogImage = new URL("/og.png", Astro.site);

const path = Astro.url.pathname.replace(/\/$/, "");
const nav = [
  { href: "/projects", key: "navProjects", label: "projects" },
  { href: "/papers", key: "navPublications", label: "publications" },
  { href: "/experience", key: "navExperience", label: "experience" },
  { href: "/about", key: "navAbout", label: "about" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Michele Tadiello" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Michele Tadiello: I get clinical data flowing and AI working where care happens" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#061d73" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="site-name" href="/">Michele Tadiello</a>
      <select id="language-select" class="language-select" aria-label="Language">
        <option value="en">English</option>
        <option value="it">Italiano</option>
        <option value="fr">Français</option>
        <option value="de">Deutsch</option>
        <option value="es">Español</option>
        <option value="ko">한국어</option>
        <option value="zh">中文</option>
        <option value="ja">日本語</option>
      </select>
      <button class="menu-btn" aria-label="Menu" aria-expanded="false" aria-controls="site-nav">
        <span></span><span></span>
      </button>
      <nav class="site-nav" id="site-nav" aria-label="Main navigation">
        {
          nav.map(({ href, key, label }) => (
            <a href={href} data-i18n={key} aria-current={path === href ? "page" : undefined}>
              {label}
            </a>
          ))
        }
        <a class="nav-btn" href="mailto:mictadiello@gmail.com" data-i18n="navEmail">email</a>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <script>
      const btn = document.querySelector(".menu-btn");
      btn.addEventListener("click", () =>
        btn.setAttribute("aria-expanded", String(btn.getAttribute("aria-expanded") !== "true")),
      );
    </script>
    <script src="../scripts/i18n.js"></script>
  </body>
</html>
