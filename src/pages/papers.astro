---
import Base from "../layouts/Base.astro";

// Google Scholar has no API, so papers come from OpenAlex at build time
// (every deploy, plus the weekly scheduled rebuild in deploy.yml).
const AUTHOR = "A5114742858";
const TOP = 5;

const res = await fetch(
  `https://api.openalex.org/works?filter=author.id:${AUTHOR}&per_page=100&select=id,title,doi,publication_year,cited_by_count,primary_location,authorships`,
);
// Failing the build keeps the last good deploy live instead of shipping an empty page.
if (!res.ok) throw new Error(`OpenAlex request failed: ${res.status}`);
const { results } = await res.json();

const seenTitles = new Set();
const papers = results
  // Skip university-repository copies of papers published in a journal
  .filter((w) => w.primary_location?.source?.type !== "repository")
  .sort((a, b) => b.cited_by_count - a.cited_by_count || b.publication_year - a.publication_year)
  .filter((w) => {
    const key = w.title.toLowerCase().replace(/[^a-z0-9]/g, "");
    if (seenTitles.has(key)) return false;
    seenTitles.add(key);
    return true;
  })
  .slice(0, TOP)
  .map((w) => ({
    title: w.title,
    href: w.doi ?? w.primary_location?.landing_page_url ?? w.id,
    venue: w.primary_location?.source?.display_name,
    year: w.publication_year,
    authors: w.authorships.map((a) => ({
      name: a.author.display_name,
      me: a.author.id.endsWith(AUTHOR),
    })),
  }));
if (papers.length === 0) throw new Error("OpenAlex returned no publications");
---

<Base title="Publications">
  <h1 class="sr-only" data-i18n="publicationsTitle">Publications</h1>
  <ul class="entries">
    {
      papers.map(({ title, href, venue, year, authors }) => (
        <li>
          <h2>
            <a href={href}>{title}</a>
          </h2>
          <p>
            {authors.map((a, i) => (
              <>
                {i > 0 && ", "}
                {a.me ? <strong>{a.name}</strong> : a.name}
              </>
            ))}
            . {venue && <cite>{venue}</cite>}
            {venue && ", "}
            {year}.
          </p>
        </li>
      ))
    }
  </ul>
  <p class="aside">
    <a
      class="scholar-btn"
      href="https://scholar.google.com/citations?user=yyzWSssAAAAJ"
      rel="noopener"
      data-i18n="scholarLink"
    >
      View all publications on Google Scholar
    </a>
  </p>
</Base>
