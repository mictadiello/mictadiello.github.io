---
import Base from "../layouts/Base.astro";

const roles = [
  { org: "Hackensack University Medical Center", key: "roleHackensack", role: "Clinical Informatics Engineer" },
  { org: "Columbia University Irving Medical Center", key: "roleColumbia", role: "Senior Informatics Specialist" },
  { org: "One Fact Foundation", key: "roleOneFact", role: "Head of Product" },
  { org: "Duke University Pratt School of Engineering – Fellow, Design Health Program", key: "roleDuke", role: "Product Design" },
  { org: "University Hospital of Verona", key: "roleVerona", role: "Registered Nurse" },
];
---

<Base title="Experience">
  <h1 class="sr-only" data-i18n="experienceTitle">Professional Experience</h1>
  <ul class="entries">
    {
      roles.map(({ org, key, role }) => (
        <li>
          <h2 data-i18n={key}>{role}</h2>
          <p class="org">{org}</p>
        </li>
      ))
    }
  </ul>
  <div class="prose">
    <h2 data-i18n="stackTitle">Stack</h2>
    <p data-i18n-html="stackInformatics">
      <strong>Informatics &amp; AI/ML:</strong> GenAI, NLP/LLM systems, predictive modeling, RAG
      architecture, clinical analytics, EHR data (Epic Clarity), FHIR/HL7, OMOP CDM, GCP, RWE.
    </p>
    <p data-i18n-html="stackTechnical">
      <strong>Technical Stack:</strong> Python, PyTorch, TensorFlow, Hugging Face, LangChain, OpenAI API,
      Claude Code, Microsoft Copilot, BigQuery, Dataform, Dataplex, Looker Studio, SQL, MySQL, AWS,
      Azure, Google Cloud, GitHub, Jira, Figma, Asana.
    </p>
  </div>
</Base>
