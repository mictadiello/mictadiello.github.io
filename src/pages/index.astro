---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import portrait from "../assets/home.jpg";
---

<Base>
  <div class="home">
    <div class="home-text">
      <h1 data-i18n="heroTitle">I get clinical data flowing and AI working where care happens</h1>
      <p class="lede" data-i18n-html="heroFocus">
        Clinical Informatics<br />Healthcare AI<br />Strategy &amp; Advisory
      </p>
      <p class="lede">
        <a class="cta" href="mailto:mictadiello@gmail.com" data-i18n="navEmail">email</a>
        &nbsp;<a href="https://www.linkedin.com/in/michele-tadiello" rel="noopener">linkedin</a>
        &nbsp;<a href="https://github.com/mictadiello" rel="noopener">github</a>
      </p>
    </div>
    <Image
      class="home-portrait"
      src={portrait}
      alt="Michele Tadiello at the AMIA 2024 Annual Symposium"
      widths={[400, 800]}
      sizes="(min-width: 56rem) 22rem, 100vw"
      loading="eager"
    />
  </div>
</Base>
