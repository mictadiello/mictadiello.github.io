---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import portrait from "../assets/picture.jpg";
---

<Base title="About">
  <h1 class="sr-only" data-i18n="aboutTitle">About</h1>
  <div class="prose">
    <div class="portrait">
      <Image
        src={portrait}
        alt="Michele Tadiello in the Dolomites, Italy"
        widths={[480, 960]}
        sizes="20rem"
        loading="eager"
      />
      <!-- Same photo again, masked to the sky; it pans on scroll so the clouds drift -->
      <Image
        class="portrait-sky"
        src={portrait}
        alt=""
        aria-hidden="true"
        widths={[480, 960]}
        sizes="20rem"
        loading="eager"
      />
    </div>
    <p data-i18n="aboutLead">
      I help health systems and health-tech companies adopt AI and digital health technologies,
      and use clinical and operational data to find bottlenecks and turn analytics into decisions.
      I advise on AI/ML implementation, interoperability (OMOP, FHIR, HL7), and putting new tools
      to work in clinical settings.
    </p>
    <p data-i18n="aboutPast">
      In previous lives I was a nurse, a business partner in a home care delivery clinic, and later
      worked at a university medical center during the Covid pandemic.
    </p>
    <p data-i18n="aboutEducation">
      I hold a Master of Management in Clinical Informatics from Duke University School of
      Medicine, with a certificate in Innovation and Entrepreneurship, and a Bachelor of Nursing
      from the University of Verona.
    </p>
    <p data-i18n="aboutPersonal">
      I’m Italian, and outside of work I love football, reading books, and listening to music including jazz. I’m also a geek for ancient Japanese and Korean architecture, a passion that comes from my high school diploma in civil engineering and architecture.
    </p>
  </div>
  <ul class="links" aria-label="Contact">
    <li><a href="mailto:mictadiello@gmail.com" data-i18n="navEmail">email</a></li>
    <li><a href="https://www.linkedin.com/in/michele-tadiello" rel="noopener">linkedin</a></li>
    <li><a href="https://github.com/mictadiello" rel="noopener">github</a></li>
    <li><a href="https://scholar.google.com/citations?user=yyzWSssAAAAJ" rel="noopener">scholar</a></li>
  </ul>
</Base>

<script>
  // Pan the sky layer with the scroll position so the clouds drift past
  const sky = document.querySelector<HTMLImageElement>(".portrait-sky");
  if (sky && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
    let queued = false;
    const update = () => {
      // Full drift within ~350px, while the sky is still on screen
      const room = Math.min(document.documentElement.scrollHeight - innerHeight, 350);
      const progress = room > 0 ? Math.min(scrollY / room, 1) : 0;
      sky.style.objectPosition = `${62 - progress * 40}% center`;
      queued = false;
    };
    addEventListener(
      "scroll",
      () => {
        if (!queued) {
          queued = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );
  }
</script>
