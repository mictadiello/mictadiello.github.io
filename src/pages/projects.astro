---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import wieny from "../assets/projects/wieny.jpg";
import heartly from "../assets/projects/heartly.webp";

// One line-icon style for every project: 24×24, stroked in currentColor
const icons = {
  document: `<path d="M14 3H6a1 1 0 0 0-1 1v16a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V8z"/><path d="M14 3v5h5"/><path d="M8 13h8M8 16.5h6"/><path d="M9.5 5.5l.6 1.4 1.4.6-1.4.6-.6 1.4-.6-1.4-1.4-.6 1.4-.6z"/>`,
  chip: `<rect x="7" y="7" width="10" height="10" rx="1"/><rect x="10" y="10" width="4" height="4"/><path d="M9.5 3v4M14.5 3v4M9.5 17v4M14.5 17v4M3 9.5h4M3 14.5h4M17 9.5h4M17 14.5h4"/>`,
  chat: `<path d="M4 3.5h16a1 1 0 0 1 1 1v11.5a1 1 0 0 1-1 1h-9.5l-4.5 4v-4H4a1 1 0 0 1-1-1V4.5a1 1 0 0 1 1-1z"/><path d="M8 10.25h.01M12 10.25h.01M16 10.25h.01" stroke-width="3"/>`,
  exchange: `<rect x="3" y="3.5" width="7" height="7" rx="1"/><rect x="14" y="13.5" width="7" height="7" rx="1"/><path d="M10 7h5a2 2 0 0 1 2 2v4.5M15 11.5l2 2 2-2"/><path d="M14 17H9a2 2 0 0 1-2-2v-4.5M5 12.5l2-2 2 2"/>`,
};

const projects = [
  {
    name: "AI-Powered Clinical Documentation Intelligence",
    key: "projCdi",
    href: "https://youtu.be/CbKR55ac1jM",
    icon: "document",
    desc: "Using Palantir AIP, it assigns ICD-10 codes and DRGs from clinical notes, identifies missing diagnoses, and highlights CMS-defined CC/MCC severity and reimbursement impact.",
  },
  {
    name: "SONAICE",
    key: "projSonaice",
    icon: "chip",
    desc: "Hybrid computational infrastructure powered by NVIDIA GPUs for Columbia School of Nursing.",
  },
  {
    name: "LEA (Leading Educational Assistant)",
    key: "projLea",
    icon: "chat",
    desc: "AI teaching assistant for Columbia School of Nursing, running locally on desktop and mobile devices to enhance nursing education and technology literacy.",
  },
  {
    name: "Interoperability Feasibility Study: Development of a Master Data Element Set",
    key: "projMde",
    href: "https://drive.google.com/file/d/1TIEXy4WtOpUl6uigUrIln3qj_6ysrXuI/view?usp=drive_link",
    icon: "exchange",
    desc: "A solution for increasing interoperability of health data between FHIR and OMOP through the creation of a Master Data Element (MDE) set.",
  },
  {
    name: "Heartly: Infant Monitoring Health System",
    key: "projHeartly",
    href: "https://drive.google.com/file/d/1VoltNlJKetsFXCU_9JorBWGbMvL5e5Ax/view?usp=drive_link",
    logo: heartly,
    // Badge matches the logo's own background so no rectangle shows
    badge: "#e0ecf8",
    desc: "Medical device prototypes focused on tracking pediatric patients with Hypoplastic Left Heart Syndrome (HLHS).",
  },
  {
    name: "Wieny",
    key: "projWieny",
    logo: wieny,
    desc: "Dog walking app to promote health and wellbeing through mobility, tracking calories and distance with GPS.",
  },
];
---

<Base title="Projects">
  <h1 class="sr-only" data-i18n="projectsTitle">Projects</h1>
  <ul class="entries projects">
    {
      projects.map(({ name, key, href, icon, logo, badge, desc }) => (
        <li>
          {logo ? (
            <Image
              class:list={["project-icon", "project-logo", { wide: logo.width > logo.height }]}
              style={badge && `background: ${badge}`}
              src={logo}
              alt=""
              widths={[56, 112]}
              sizes="3.5rem"
            />
          ) : (
            <svg
              class="project-icon"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <Fragment set:html={icons[icon]} />
            </svg>
          )}
          <div>
            <h2>
              {href ? (
                <a href={href} target="_blank" rel="noopener">
                  {name}<span aria-hidden="true">&nbsp;↗</span>
                  <span class="sr-only"> (opens in a new tab)</span>
                </a>
              ) : (
                name
              )}
            </h2>
            <p data-i18n={key}>{desc}</p>
          </div>
        </li>
      ))
    }
  </ul>
</Base>
